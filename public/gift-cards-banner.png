<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Store Credit Admin — Little Haven</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{--cream:#faf7f3;--rose:#c97d76;--rose-deep:#a85f59;--sage:#7ba676;--sage-dark:#4d7848;--slate:#5c6470;--charcoal:#2a2622;--taupe:#aea298;}
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:'Nunito',sans-serif;background:var(--cream);color:var(--charcoal);padding:28px 16px;line-height:1.6}
  .wrap{max-width:460px;margin:0 auto}
  h1{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:2rem;text-align:center;margin-bottom:4px}
  .sub{text-align:center;color:var(--slate);font-weight:600;font-size:.85rem;margin-bottom:22px}
  .card{background:#fff;border:1px solid rgba(0,0,0,.05);border-radius:18px;padding:18px;box-shadow:0 4px 24px rgba(0,0,0,.07);margin-bottom:16px}
  .card h2{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:1.3rem;margin-bottom:12px}
  label{display:block;font-size:.66rem;font-weight:800;color:var(--taupe);text-transform:uppercase;letter-spacing:.08em;margin:10px 0 5px}
  input{width:100%;border:1.5px solid #e7ddd0;border-radius:11px;padding:11px 13px;font-family:'Nunito';font-weight:600;font-size:.95rem;background:#fcfaf6;outline:none}
  input:focus{border-color:var(--rose)}
  button{width:100%;border:none;border-radius:30px;padding:13px;font-family:'Nunito';font-weight:800;font-size:.78rem;letter-spacing:.07em;text-transform:uppercase;color:#fff;background:var(--rose);cursor:pointer;margin-top:14px}
  button:hover{background:var(--rose-deep)}
  button.alt{background:var(--sage)}button.alt:hover{background:var(--sage-dark)}
  .out{margin-top:14px;padding:13px;border-radius:11px;font-weight:700;font-size:.9rem;display:none}
  .out.ok{display:block;background:#e4f0e7;color:var(--sage-dark)}
  .out.err{display:block;background:#f7e3df;color:#b8524a}
  .code{font-size:1.6rem;font-weight:800;color:var(--rose-deep);letter-spacing:1px;text-align:center;margin:6px 0}
  .note{font-size:.76rem;color:var(--taupe);font-weight:700;margin-top:8px}
</style>
</head>
<body>
<div class="wrap">
  <h1>Store Credit</h1>
  <div class="sub">Issue and look up Little Haven store credit codes</div>

  <div class="card">
    <label>Admin key</label>
    <input type="password" id="key" placeholder="Your ADMIN_KEY">
    <div class="note">Set once in Netlify → Environment variables as ADMIN_KEY. Keep it private.</div>
  </div>

  <div class="card">
    <h2>Post a news update</h2>
    <label>Headline (optional)</label>
    <input type="text" id="nwHead" placeholder="e.g. Closed Monday 6/8">
    <label>Message</label>
    <textarea id="nwBody" rows="3" style="width:100%;border:1.5px solid #e7ddd0;border-radius:11px;padding:10px 12px;font-family:'Nunito';font-weight:600;background:#fcfaf6" placeholder="e.g. We'll be closed Monday 6/8 and back open Tuesday at 9 AM. See you soon!"></textarea>
    <label>Show until (optional) — banner auto-hides the day after this date</label>
    <input type="date" id="nwUntil">
    <button id="nwSave">Post to homepage</button>
    <button class="alt" id="nwClear" style="margin-left:6px">Clear news</button>
    <div class="out" id="nwOut"></div>
    <p class="note">Shows a "News" banner + menu link on your homepage. Clearing it hides the banner automatically.</p>
  </div>

  <div class="card">
    <h2>Upcoming events</h2>
    <input type="hidden" id="evId">
    <label>Title</label>
    <input type="text" id="evTitle" placeholder="e.g. Toddler Music Class">
    <label>Description</label>
    <textarea id="evDesc" rows="3" style="width:100%;border:1.5px solid #e7ddd0;border-radius:11px;padding:10px 12px;font-family:'Nunito';font-weight:600;background:#fcfaf6" placeholder="What the event is about, what to bring, age range…"></textarea>
    <div class="row">
      <div><label>Date &amp; time</label><input type="datetime-local" id="evWhen"></div>
      <div><label>Price per ticket ($)</label><input type="text" id="evPrice" inputmode="decimal" placeholder="15"></div>
    </div>
    <div class="row">
      <div><label>Capacity (total tickets)</label><input type="number" id="evCap" min="1" placeholder="12"></div>
      <div><label>Poster image (optional)</label><input type="file" id="evPoster" accept="image/*"></div>
    </div>
    <button id="evSave">Save event</button>
    <button class="ghost" id="evReset" style="margin-left:6px;background:#eee;color:var(--charcoal)">New / clear form</button>
    <div class="out" id="evOut"></div>
    <div id="evList" style="margin-top:14px"></div>
    <p class="note">Events automatically move to "Past events" on the site after their date (no ticket sales). Capacity can't drop below tickets already sold.</p>
  </div>

  <div class="card">
    <h2>Bookings by date</h2>
    <label>Date</label>
    <input type="date" id="rosDate">
    <button id="rosView">View roster</button>
    <div id="rosOut" style="margin-top:14px"></div>
    <p class="note">Shows everyone booked per session — name, party size, and how they paid — to match against signed waivers.</p>
  </div>

  <div class="card">
    <h2>Issue a new credit</h2>
    <label>Amount (USD)</label>
    <input type="text" id="amount" inputmode="decimal" placeholder="e.g. 17.00">
    <label>Reason (optional)</label>
    <input type="text" id="reason" placeholder="e.g. No-show credit for Jane D., 6/2 booking">
    <button id="issue">Generate code</button>
    <div class="out" id="issueOut"></div>
  </div>

  <div class="card">
    <h2>Check a credit balance</h2>
    <label>Code</label>
    <input type="text" id="lookup" placeholder="LHC123ABC">
    <button class="alt" id="check">Check balance</button>
    <div class="out" id="checkOut"></div>
  </div>

  <div class="card">
    <h2>Deactivate a code</h2>
    <label>Visit pass or store credit code</label>
    <input type="text" id="deact" placeholder="e.g. AR4655-4 or LHC123ABC">
    <button id="deactivate">Deactivate code</button>
    <div class="out" id="deactOut"></div>
    <p class="note">Use after a refund or accidental charge so the code can no longer be redeemed. Gift cards are deactivated in your Square Dashboard → Gift Cards.</p>
  </div>

  <div class="card">
    <h2>Reserve a slot for a private party</h2>
    <label>Date</label>
    <input type="date" id="rzDate">
    <label>Time slot</label>
    <select id="rzSlot">
      <option value="9-11">9:00 - 11:00 AM</option>
      <option value="11-1">11:00 AM - 1:00 PM</option>
      <option value="1-3">1:00 - 3:00 PM</option>
      <option value="2-4">2:00 - 4:00 PM (Fri/Sat)</option>
    </select>
    <label>Note (optional)</label>
    <input type="text" id="rzNote" placeholder="e.g. Smith party — deposit paid">
    <button id="rzReserve">Reserve for private party</button>
    <button class="alt" id="rzRelease" style="margin-top:8px">Release back to open play</button>
    <div class="out" id="rzOut"></div>
    <p class="note">Reserving hides that session from open play so no one can book it. Release it to make it bookable again.</p>
  </div>
</div>

<script>
const $=s=>document.querySelector(s);
const money=c=>"$"+(c/100).toFixed(2);

$("#issue").onclick=async()=>{
  const out=$("#issueOut"); out.className="out"; out.style.display="none";
  const key=$("#key").value.trim(), amount=$("#amount").value.trim(), reason=$("#reason").value.trim();
  if(!key){ out.className="out err"; out.textContent="Enter your admin key."; return; }
  if(!amount){ out.className="out err"; out.textContent="Enter an amount."; return; }
  $("#issue").disabled=true; $("#issue").textContent="Working…";
  try{
    const r=await (await fetch("/api/credit-issue",{method:"POST",headers:{"content-type":"application/json"},
      body:JSON.stringify({key,amount,reason})})).json();
    if(r.ok){ out.className="out ok"; out.innerHTML=`Credit created — give this code to the customer:<div class="code">${r.code}</div>${money(r.amount)} · expires ${r.expiry}`; $("#amount").value="";$("#reason").value=""; }
    else { out.className="out err"; out.textContent=r.error||"Couldn't create credit."; }
  }catch(e){ out.className="out err"; out.textContent="Network error."; }
  $("#issue").disabled=false; $("#issue").textContent="Generate code";
};

$("#check").onclick=async()=>{
  const out=$("#checkOut"); out.className="out"; out.style.display="none";
  const code=$("#lookup").value.trim().toUpperCase();
  if(!code){ out.className="out err"; out.textContent="Enter a code."; return; }
  try{
    const r=await (await fetch("/api/credit-balance?code="+encodeURIComponent(code))).json();
    if(r.ok){ out.className="out ok"; out.innerHTML=`Balance: <b>${money(r.balance)}</b> · expires ${r.expiry}`; }
    else { out.className="out err"; out.textContent=r.error||"Not found."; }
  }catch(e){ out.className="out err"; out.textContent="Network error."; }
};

$("#deactivate").onclick=async()=>{
  const out=$("#deactOut"); out.className="out"; out.style.display="none";
  const key=$("#key").value.trim(), code=$("#deact").value.trim().toUpperCase();
  if(!key){ out.className="out err"; out.textContent="Enter your admin key (top of page)."; return; }
  if(!code){ out.className="out err"; out.textContent="Enter a code to deactivate."; return; }
  if(!confirm("Deactivate "+code+"? This cannot be undone and the code will stop working.")) return;
  $("#deactivate").disabled=true; $("#deactivate").textContent="Working…";
  try{
    const r=await (await fetch("/api/code-deactivate",{method:"POST",headers:{"content-type":"application/json"},
      body:JSON.stringify({key,code})})).json();
    if(r.ok){ out.className="out ok"; out.innerHTML=`<b>${r.type} ${r.code}</b> deactivated. ${r.message||""}`; $("#deact").value=""; }
    else { out.className="out err"; out.textContent=r.error||"Couldn't deactivate that code."; }
  }catch(e){ out.className="out err"; out.textContent="Network error."; }
  $("#deactivate").disabled=false; $("#deactivate").textContent="Deactivate code";
};
async function rzCall(action){
  const out=$("#rzOut"); out.className="out"; out.style.display="none";
  const key=$("#key").value.trim(), date=$("#rzDate").value, slot=$("#rzSlot").value, note=$("#rzNote").value.trim();
  if(!key){ out.className="out err"; out.textContent="Enter your admin key (top of page)."; return; }
  if(!date){ out.className="out err"; out.textContent="Pick a date."; return; }
  try{
    const r=await (await fetch("/api/slot-block",{method:"POST",headers:{"content-type":"application/json"},
      body:JSON.stringify({key,date,slot,note,action})})).json();
    if(r.ok){ out.className="out ok"; out.innerHTML=`<b>${date} · ${slot}</b> — ${r.message||"done"}`; }
    else { out.className="out err"; out.textContent=r.error||"Couldn't update that slot."; }
  }catch(e){ out.className="out err"; out.textContent="Network error."; }
}
$("#rzReserve").onclick=()=>rzCall("reserve");
$("#rzRelease").onclick=()=>rzCall("release");
$("#rosView").onclick=async()=>{
  const out=$("#rosOut"); out.innerHTML="";
  const key=$("#key").value.trim(), date=$("#rosDate").value;
  if(!key){ out.innerHTML='<div class="out err" style="display:block">Enter your admin key (top of page).</div>'; return; }
  if(!date){ out.innerHTML='<div class="out err" style="display:block">Pick a date.</div>'; return; }
  out.innerHTML='<div class="note">Loading…</div>';
  try{
    const r=await (await fetch("/api/roster?key="+encodeURIComponent(key)+"&date="+encodeURIComponent(date))).json();
    if(r.error){ out.innerHTML='<div class="out err" style="display:block">'+r.error+'</div>'; return; }
    if(!r.sessions.length){ out.innerHTML='<div class="note">No bookings for '+date+' yet.</div>'; return; }
    let html='<div class="note" style="margin-bottom:8px">'+r.dayTotalChildren+' children · '+r.dayTotalGuests+' total guests on '+date+'</div>';
    r.sessions.forEach(s=>{
      html+='<div style="border:1px solid #e7ddd0;border-radius:12px;padding:12px;margin-bottom:10px">';
      html+='<div style="font-weight:800;color:var(--rose-deep)">'+s.label+(s.reserved?' — RESERVED (private party)':'')+' · '+s.children+' children</div>';
      if(s.people.length){
        html+='<table style="width:100%;border-collapse:collapse;margin-top:8px;font-size:.85rem">';
        s.people.forEach(p=>{
          const parts=[]; if(p.regular)parts.push(p.regular+' reg'); if(p.sibling)parts.push(p.sibling+' sib'); if(p.infant)parts.push(p.infant+' inf');
          html+='<tr style="border-top:1px solid #f0e9df">'
              +'<td style="padding:6px 0;font-weight:700">'+esc(p.name)+'</td>'
              +'<td style="padding:6px 0;color:var(--slate)">'+parts.join(", ")+' · '+p.adults+' adult'+(p.adults===1?'':'s')+'</td>'
              +'<td style="padding:6px 0;color:var(--taupe);text-align:right">'+esc(p.paid)+'</td></tr>';
          if(p.email) html+='<tr><td colspan="3" style="padding:0 0 6px;color:var(--taupe);font-size:.78rem">'+esc(p.email)+'</td></tr>';
        });
        html+='</table>';
      } else if(s.reserved){ html+='<div class="note" style="margin-top:6px">Held for a private party — no open play bookings.</div>'; }
      html+='</div>';
    });
    out.innerHTML=html;
  }catch(e){ out.innerHTML='<div class="out err" style="display:block">Network error.</div>'; }
};
function esc(s){ return (s||"").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }
async function nwCall(action){
  const out=$("#nwOut"); out.className="out";
  const key=$("#key").value.trim();
  if(!key){ out.className="out err"; out.textContent="Enter your admin key (top of page)."; return; }
  if(action==="clear" && !confirm("Clear the news banner from your homepage?")) return;
  try{
    const r=await (await fetch("/api/news-set",{method:"POST",headers:{"content-type":"application/json"},
      body:JSON.stringify({key,action,headline:$("#nwHead").value.trim(),body:$("#nwBody").value.trim(),showUntil:$("#nwUntil").value})})).json();
    if(r.ok){ out.className="out ok"; out.textContent=r.message||"Done."; if(r.cleared){ $("#nwHead").value=""; $("#nwBody").value=""; } }
    else { out.className="out err"; out.textContent=r.error||"Couldn't update news."; }
  }catch(e){ out.className="out err"; out.textContent="Network error."; }
}
$("#nwSave").onclick=()=>nwCall("save");
$("#nwClear").onclick=()=>nwCall("clear");
// ---- Events manager ----
function evMoney(c){return "$"+(c/100).toFixed(2);}
async function shrinkImage(file){
  return new Promise((resolve)=>{
    const fr=new FileReader();
    fr.onload=()=>{ const img=new Image(); img.onload=()=>{
      const max=1100; let{width:w,height:h}=img;
      if(w>max||h>max){ if(w>h){h=Math.round(h*max/w);w=max;}else{w=Math.round(w*max/h);h=max;} }
      const c=document.createElement("canvas"); c.width=w;c.height=h;
      c.getContext("2d").drawImage(img,0,0,w,h);
      resolve(c.toDataURL("image/jpeg",0.82));
    }; img.onerror=()=>resolve(null); img.src=fr.result; };
    fr.onerror=()=>resolve(null); fr.readAsDataURL(file);
  });
}
async function loadEvents(){
  const key=$("#key").value.trim(); if(!key) return;
  try{
    const r=await (await fetch("/api/event-admin",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({key,action:"list"})})).json();
    if(!r.ok){ $("#evList").innerHTML='<div class="out err" style="display:block">'+(r.error||"Couldn't load events")+'</div>'; return; }
    if(!r.events.length){ $("#evList").innerHTML='<div class="note">No events yet.</div>'; return; }
    window._events={}; let html="";
    r.events.forEach(e=>{ window._events[e.id]=e;
      const when=new Date(e.dateTime).toLocaleString();
      html+='<div style="border:1px solid #e7ddd0;border-radius:11px;padding:10px;margin-top:8px">'
        +'<div style="font-weight:800">'+esc(e.title)+(e.past?' <span class="note" style="color:#b8524a">(past)</span>':'')+'</div>'
        +'<div style="font-size:.83rem;color:var(--slate)">'+esc(when)+' · '+evMoney(e.price)+' · '+e.sold+'/'+e.capacity+' sold</div>'
        +'<div style="margin-top:6px;display:flex;gap:6px;flex-wrap:wrap">'
        +'<button onclick="editEvent(\''+e.id+'\')" style="margin:0">Edit</button>'
        +'<button class="alt" onclick="rosterEvent(\''+e.id+'\')" style="margin:0">Roster</button>'
        +'<button class="ghost" style="margin:0;background:#eee;color:#2a2622" onclick="releaseEvent(\''+e.id+'\')">Release tickets</button>'
        +'<button class="ghost" style="margin:0;background:#f7e3df;color:#b8524a" onclick="deleteEvent(\''+e.id+'\')">Delete</button>'
        +'</div><div class="out" id="evrow-'+e.id+'"></div></div>';
    });
    $("#evList").innerHTML=html;
  }catch(e){ $("#evList").innerHTML='<div class="out err" style="display:block">Network error.</div>'; }
}
window.editEvent=(id)=>{
  const e=window._events[id]; if(!e) return;
  $("#evId").value=e.id; $("#evTitle").value=e.title; $("#evDesc").value=e.description||"";
  $("#evWhen").value=(e.dateTime||"").slice(0,16); $("#evPrice").value=(e.price/100).toFixed(2); $("#evCap").value=e.capacity;
  $("#evPoster").value=""; window.scrollTo({top:0,behavior:"smooth"});
  $("#evOut").className="out ok"; $("#evOut").textContent="Editing \u201c"+e.title+"\u201d — make changes and Save. Leave poster empty to keep the current one.";
};
window.deleteEvent=async(id)=>{
  if(!confirm("Delete this event permanently?")) return;
  const key=$("#key").value.trim();
  const r=await (await fetch("/api/event-admin",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({key,action:"delete",id})})).json();
  if(r.ok) loadEvents(); else alert(r.error||"Couldn't delete.");
};
window.releaseEvent=async(id)=>{
  const count=prompt("How many tickets to release back? (e.g. after a refund)","1");
  if(!count) return;
  const key=$("#key").value.trim();
  const out=$("#evrow-"+id);
  const r=await (await fetch("/api/event-admin",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({key,action:"release",id,count})})).json();
  if(out){ out.className="out "+(r.ok?"ok":"err"); out.textContent=r.message||r.error; }
  if(r.ok) loadEvents();
};
window.rosterEvent=async(id)=>{
  const key=$("#key").value.trim(); const out=$("#evrow-"+id);
  const r=await (await fetch("/api/event-admin",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({key,action:"roster",id})})).json();
  if(!r.ok){ if(out){out.className="out err";out.textContent=r.error;} return; }
  if(out){ out.className="out ok"; out.innerHTML=(r.buyers.length?r.buyers.map(x=>esc(x.name)+" — "+x.quantity+" ticket"+(x.quantity===1?"":"s")+" — "+esc(x.email)).join("<br>"):"No tickets sold yet.")+'<br><b>'+r.sold+'/'+r.capacity+' sold</b>'; }
};
$("#evReset").onclick=()=>{ ["evId","evTitle","evDesc","evWhen","evPrice","evCap"].forEach(i=>$("#"+i).value=""); $("#evPoster").value=""; $("#evOut").className="out"; };
$("#evSave").onclick=async()=>{
  const out=$("#evOut"); out.className="out";
  const key=$("#key").value.trim();
  if(!key){ out.className="out err"; out.textContent="Enter your admin key (top of page)."; return; }
  const body={ key, action:"save", id:$("#evId").value||undefined,
    title:$("#evTitle").value.trim(), description:$("#evDesc").value.trim(),
    dateTime:$("#evWhen").value, price:$("#evPrice").value, capacity:$("#evCap").value };
  const f=$("#evPoster").files[0];
  if(f){ out.className="out"; out.style.display="block"; out.textContent="Processing image…"; const d=await shrinkImage(f); if(d) body.poster=d; }
  $("#evSave").disabled=true;
  try{
    const r=await (await fetch("/api/event-admin",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(body)})).json();
    if(r.ok){ out.className="out ok"; out.textContent=r.message||"Saved."; $("#evReset").click(); loadEvents(); }
    else { out.className="out err"; out.textContent=r.error||"Couldn't save."; }
  }catch(e){ out.className="out err"; out.textContent="Network error."; }
  $("#evSave").disabled=false;
};
// load events when an admin key is present
$("#key").addEventListener("change",()=>{ if($("#key").value.trim()) loadEvents(); });
</script>
</body>
</html>
