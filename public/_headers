# Apple/Square must receive the extensionless association file as a download.
/.well-known/apple-developer-merchantid-domain-association
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename=apple-developer-merchantid-domain-association
  Cache-Control: no-store, max-age=0

/apple-developer-merchantid-domain-association
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename=apple-developer-merchantid-domain-association
  Cache-Control: no-store, max-age=0

# Required for reliable Google Pay popup behavior, especially iOS/WebViews.
/*
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
